# Keep the real key only in .env (ignored by Git).
OPENROUTER_API_KEY=

# Google AI Studio (Gemini API) alternative: https://aistudio.google.com/apikey
# GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# Which provider drives the AI agent, artifacts and inline AI actions: "openrouter" | "google"
RAGPOC_LLM_PROVIDER=openrouter

# Required before exposing the UI through any tunnel or remote URL.
RAGPOC_UI_USERNAME=operator
RAGPOC_UI_PASSWORD=

# Set automatically by desktop_launcher.py for the compiled local build
# (127.0.0.1 only, single user). Leave unset/0 when serving over the web.
RAGPOC_DESKTOP_MODE=0

# Embeddings: "openrouter" | "google" | "local". Models editable in Ajustes (names
# depend on the provider, e.g. google/gemini-embedding-2-preview on OpenRouter vs
# gemini-embedding-2-preview on Google AI Studio).
RAGPOC_EMBEDDING_PROVIDER=openrouter
RAGPOC_EMBEDDING_MODEL=google/gemini-embedding-2-preview
RAGPOC_CHAT_MODEL=google/gemini-3.7-flash
# Empty means discover/persist the returned dimension on first successful embedding.
RAGPOC_EMBEDDING_DIMENSION=

# Local embeddings (EmbeddingGemma 2 via ONNX Runtime).
# Only used when RAGPOC_EMBEDDING_PROVIDER=local.
# RAGPOC_LOCAL_EMBEDDING_MODEL=onnx-community/embeddinggemma-2-ONNX
# RAGPOC_LOCAL_EMBEDDING_DTYPE=q8
# RAGPOC_LOCAL_EMBEDDING_DEVICE=auto
# RAGPOC_LOCAL_EMBEDDING_DIM=768
# RAGPOC_LOCAL_EMBEDDING_VISION_TOKENS=140
# RAGPOC_LOCAL_EMBEDDING_CACHE_DIR=data/models

RAGPOC_DATA_DIR=data
RAGPOC_MAX_PDF_BYTES=524288000
RAGPOC_MAX_VIDEO_SECONDS=7200
RAGPOC_RENDER_CONCURRENCY=2
RAGPOC_EMBEDDING_CONCURRENCY=4
RAGPOC_EMBEDDING_BATCH_SIZE=32
RAGPOC_PIPELINE_QUEUE_SIZE=16
RAGPOC_VIDEO_SEGMENT_SECONDS=30
RAGPOC_PDF_RENDER_DPI=180
RAGPOC_MAX_TOP_K=50
RAGPOC_ALLOWED_UPLOAD_DIR=data/uploads
