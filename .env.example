# Keep the real key only in .env (ignored by Git).
OPENROUTER_API_KEY=

# Required before exposing the UI through any tunnel or remote URL.
RAGPOC_UI_USERNAME=operator
RAGPOC_UI_PASSWORD=

# Set automatically by desktop_launcher.py for the compiled local build
# (127.0.0.1 only, single user). Leave unset/0 when serving over the web.
RAGPOC_DESKTOP_MODE=0

# OpenRouter models: embeddings and streaming RAG chat.
RAGPOC_EMBEDDING_MODEL=google/gemini-embedding-2-preview
RAGPOC_CHAT_MODEL=google/gemini-3.6-flash
# Empty means discover/persist the returned dimension on first successful embedding.
RAGPOC_EMBEDDING_DIMENSION=

RAGPOC_DATA_DIR=data
RAGPOC_MAX_PDF_BYTES=524288000
RAGPOC_MAX_VIDEO_SECONDS=7200
RAGPOC_RENDER_CONCURRENCY=2
RAGPOC_EMBEDDING_CONCURRENCY=4
RAGPOC_EMBEDDING_BATCH_SIZE=32
RAGPOC_PIPELINE_QUEUE_SIZE=16
RAGPOC_VIDEO_SEGMENT_SECONDS=30
RAGPOC_PDF_RENDER_DPI=180
RAGPOC_MAX_TOP_K=50
RAGPOC_ALLOWED_UPLOAD_DIR=data/uploads
